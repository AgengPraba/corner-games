---
const { title = 'PLAYROOM — tiny games, big fun', description = 'A playful little corner of the internet for browser games.' } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff7e8" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <style is:global>
      :root{font-family:'Nunito',system-ui,sans-serif;color:#29251f;background:#fff7e8;font-synthesis:none;text-rendering:optimizeLegibility;--paper:#fff7e8;--ink:#29251f;--orange:#f36b3f;--yellow:#ffd166;--mint:#bfe8d0;--blue:#b9d8ff;--pink:#ffc6c7;--line:#29251f}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper)}button,input{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit}::selection{background:var(--yellow);color:var(--ink)}
      .wrap{width:min(1120px,calc(100% - 40px));margin-inline:auto}.mono{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;font-size:.72rem}.pixel-border{border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink)}
      .topline{height:9px;background:repeating-linear-gradient(135deg,var(--orange) 0 12px,var(--yellow) 12px 24px)}
      .site-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;border-bottom:2px solid var(--ink)}.brand{display:flex;align-items:center;gap:11px;text-decoration:none;font-weight:1000;font-size:1.45rem;letter-spacing:-.07em}.brand-mark{display:grid;place-items:center;width:40px;height:40px;background:var(--orange);border:2px solid var(--ink);box-shadow:3px 3px 0 var(--ink);font-size:1.35rem;transform:rotate(-5deg)}.nav{display:flex;align-items:center;gap:26px}.nav a{text-decoration:none;font-weight:800;font-size:.92rem}.nav a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}.nav-cta{padding:10px 16px;background:var(--yellow);border:2px solid var(--ink);box-shadow:3px 3px 0 var(--ink)}
      .hero{display:grid;grid-template-columns:1.15fr .85fr;gap:32px;align-items:center;padding:64px 0 55px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border:2px solid var(--ink);background:var(--mint);transform:rotate(-1.5deg)}.hero h1{font-size:clamp(3.4rem,7.6vw,6.5rem);line-height:.88;letter-spacing:-.085em;margin:22px 0 20px;font-weight:1000}.hero h1 .orange{color:var(--orange);text-shadow:2px 2px 0 var(--ink);-webkit-text-stroke:1px var(--ink)}.hero p{max-width:460px;color:#5d554a;font-size:1.07rem;line-height:1.7;margin:0 0 24px}.hero-actions{display:flex;gap:13px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 18px;text-decoration:none;font-weight:900;border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);transition:transform .15s,box-shadow .15s}.btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)}.btn-primary{background:var(--orange)}.btn-secondary{background:var(--paper)}
      .hero-art{position:relative;min-height:330px;display:grid;place-items:center}.art-sun{position:absolute;width:245px;height:245px;background:var(--yellow);border:2px solid var(--ink);border-radius:50%;right:13%;top:18px}.art-card{position:relative;z-index:1;width:min(330px,90%);background:var(--blue);padding:17px;border:2px solid var(--ink);box-shadow:8px 8px 0 var(--ink);transform:rotate(3deg)}.art-screen{height:180px;background:#b7e2a4;border:2px solid var(--ink);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.pixel-sun{position:absolute;top:20px;right:24px;width:33px;height:33px;background:var(--yellow);border:2px solid var(--ink);border-radius:50%}.pixel-cloud{position:absolute;top:42px;left:24px;color:#fff;font-size:2.2rem;letter-spacing:-10px}.pixel-character{font-size:5rem;filter:drop-shadow(3px 3px 0 var(--ink));transform:translateY(10px)}.art-label{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:12px;font-weight:900}.art-sticker{position:absolute;z-index:2;left:0;bottom:23px;background:var(--pink);padding:11px 14px;border:2px solid var(--ink);box-shadow:3px 3px 0 var(--ink);font-weight:1000;transform:rotate(-9deg)}.spark{position:absolute;font-size:2rem;color:var(--orange);font-weight:1000}.spark.one{top:10px;left:10%}.spark.two{right:3%;bottom:24px;color:#6a7de4}
      .ticker{background:var(--ink);color:var(--paper);overflow:hidden;padding:12px 0;white-space:nowrap}.ticker-inner{display:flex;justify-content:space-around;gap:28px}.ticker span{font-family:'DM Mono',monospace;font-size:.75rem;letter-spacing:.12em}.ticker b{color:var(--yellow);margin-right:10px}
      .section{padding:54px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:23px}.section-kicker{color:var(--orange);font-weight:1000;margin-bottom:6px}.section h2{font-size:clamp(2rem,4vw,3rem);line-height:1;letter-spacing:-.06em;margin:0;font-weight:1000}.section-note{max-width:290px;color:#6d6458;line-height:1.5;font-size:.92rem}.catalog-tools{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:22px}.search{display:flex;align-items:center;gap:9px;background:#fffdf7;border:2px solid var(--ink);padding:11px 13px;min-width:min(300px,100%);flex:1;max-width:390px;box-shadow:3px 3px 0 var(--ink)}.search input{border:0;outline:0;background:transparent;width:100%;min-width:0;color:var(--ink)}.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{cursor:pointer;padding:9px 13px;border:2px solid var(--ink);background:transparent;font-size:.82rem;font-weight:900;transition:background .15s,transform .15s}.filter:hover{transform:translateY(-2px)}.filter.active{background:var(--yellow);box-shadow:2px 2px 0 var(--ink)}
      .game-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.game-card{background:#fffdf7;border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);transition:transform .16s,box-shadow .16s;min-width:0}.game-card:hover{transform:translate(-2px,-3px);box-shadow:7px 7px 0 var(--ink)}.game-link{text-decoration:none;display:block;height:100%}.game-cover{height:190px;position:relative;display:grid;place-items:center;border-bottom:2px solid var(--ink);overflow:hidden}.cover-orange{background:#ffb18f}.cover-blue{background:#b9d8ff}.cover-mint{background:#bfe8d0}.cover-pink{background:#ffc6c7}.cover-yellow{background:#ffe08a}.cover-lilac{background:#d6c8ff}.cover-art{font-size:5rem;filter:drop-shadow(3px 4px 0 rgba(41,37,31,.18));transition:transform .2s}.game-card:hover .cover-art{transform:scale(1.12) rotate(-4deg)}.game-badge{position:absolute;top:12px;left:12px;padding:5px 8px;background:var(--paper);border:2px solid var(--ink);font:500 .65rem 'DM Mono',monospace;text-transform:uppercase}.game-badge.newBadge{background:var(--yellow)}.cover-number{position:absolute;bottom:8px;right:12px;font:500 .7rem 'DM Mono',monospace}.game-info{padding:16px}.game-title-row{display:flex;align-items:start;justify-content:space-between;gap:10px}.game-title{font-size:1.2rem;letter-spacing:-.04em;margin:0;font-weight:1000}.game-arrow{font-size:1.15rem;font-weight:900}.game-desc{font-size:.88rem;line-height:1.5;color:#71685d;margin:7px 0 14px;min-height:40px}.game-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-top:11px;border-top:1px dashed #c8bfb1;color:#6d6458;font-size:.75rem;font-family:'DM Mono',monospace;text-transform:uppercase}.empty-state{grid-column:1/-1;text-align:center;padding:44px 20px;border:2px dashed #b8aa98;color:#6d6458}
      .about{display:grid;grid-template-columns:.85fr 1.15fr;gap:30px;align-items:center;padding:28px;background:var(--mint);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink)}.about-art{min-height:190px;display:grid;place-items:center;background:var(--yellow);border:2px solid var(--ink);font-size:5.3rem}.about h2{font-size:2.3rem;letter-spacing:-.07em;line-height:1;margin:0 0 14px}.about p{line-height:1.7;color:#514c42;margin:0 0 18px}.tech-tags{display:flex;gap:8px;flex-wrap:wrap}.tech-tags span{padding:6px 10px;background:var(--paper);border:1.5px solid var(--ink);font:500 .7rem 'DM Mono',monospace}
      .footer{margin-top:60px;border-top:2px solid var(--ink);padding:26px 0 32px;display:flex;justify-content:space-between;gap:18px;align-items:center;color:#6d6458;font-size:.82rem}.footer strong{color:var(--ink)}.footer a{font-weight:900;text-decoration:none}.footer a:hover{text-decoration:underline}
      @media(max-width:760px){.wrap{width:min(100% - 28px,600px)}.site-header{padding:17px 0}.nav{gap:13px}.nav a:not(.nav-cta){display:none}.hero{grid-template-columns:1fr;gap:8px;padding:45px 0 38px}.hero h1{font-size:clamp(3.5rem,16vw,5.6rem)}.hero-art{min-height:300px}.art-card{width:min(310px,82%)}.art-screen{height:160px}.section{padding:42px 0}.section-head{align-items:start;flex-direction:column}.section-note{max-width:480px}.game-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.game-cover{height:155px}.cover-art{font-size:4.1rem}.game-info{padding:12px}.game-title{font-size:1.05rem}.game-desc{font-size:.82rem;min-height:60px}.about{grid-template-columns:1fr;padding:18px}.about-art{min-height:145px}.footer{align-items:flex-start;flex-direction:column;margin-top:42px}}@media(max-width:430px){.brand{font-size:1.25rem}.brand-mark{width:35px;height:35px}.nav-cta{padding:8px 10px;font-size:.8rem}.game-grid{gap:11px}.game-cover{height:125px}.cover-art{font-size:3.4rem}.game-badge{font-size:.55rem;top:7px;left:7px}.game-info{padding:10px}.game-title{font-size:.96rem}.game-desc{font-size:.77rem;min-height:68px}.game-meta{font-size:.62rem;gap:4px}.catalog-tools{align-items:stretch}.search{max-width:none}.filters{gap:6px}.filter{padding:7px 9px;font-size:.75rem}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
    </style>
  </head>
  <body><div class="topline"></div><slot /></body>
</html>
